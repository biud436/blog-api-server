{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2017",
        "lib": ["esnext"],
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./",
        "incremental": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "paths": {
            "src/*": ["./src/*"],
            "test/*": ["./test/*"],
            "@app/env": ["./libs/env/src"],
            "@app/env/*": ["./libs/env/src/*"]
        },
        "typeRoots": ["./node_modules/@types", "./types"],
        "strict": true,
        "strictNullChecks": true,
        "esModuleInterop": true
    },
    "include": ["src", "types", "test/units", "test/utils", "test/fixtures"]
}
